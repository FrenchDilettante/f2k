# F2K .gitignore

# Build artifacts
target/

# Cargo generated files
Cargo.lock

# Python generated files
scripts/__pycache__

# IDE files
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

# Linux
*~

# Binary files
*.bin
# ...except the files fixture's data tree, which is test input.
!/tests/kernel32/files/DATA/**
*.elf
*.obj
*.img
# The source-stamp tool tests/build.bat builds on the real machine (common/srcsum.c)
tests/common/srcsum.exe
*.vdi
*.iso

# Checked-in test fixtures (the host tests embed them at compile time)
!kernel/src/fs/fat32/testdata/*.bin

# The scratch directories the write fixtures leave beside their programs on the real machine
tests/kernel32/fswrite/SCRATCH/
tests/crt/fd/SCRATCH/

# The files make vbox-image adds to the VirtualBox disk: the owner's own, never committed
/vbox-image/*
!/vbox-image/.gitkeep

# Logs
*.log

# Temporary files
tmp/
temp/

# limine build artifacts
boot/limine/*.o
boot/limine/limine
boot/limine/limine.sys

# Python tooling (uv)
.venv/
__pycache__/
.pytest_cache/
