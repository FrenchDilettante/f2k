# F2K .gitignore

# Build artifacts
target/

# Cargo generated files
Cargo.lock

# Python generated files
scripts/__pycache__

# IDE files
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

# Linux
*~

# Binary files
*.bin
*.elf
*.obj
*.img
*.vdi
*.iso

# Checked-in test fixtures (the host tests embed them at compile time)
!kernel/src/fs/fat32/testdata/*.bin

# Logs
*.log

# Temporary files
tmp/
temp/

# limine build artifacts
boot/limine/*.o
boot/limine/limine
boot/limine/limine.sys
