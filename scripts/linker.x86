/* Linker script for the F2K kernel (Multiboot 1, 32-bit x86) */

OUTPUT_FORMAT("elf32-i386")
OUTPUT_ARCH(i386)

ENTRY(_start)

SECTIONS
{
    /* Entry trampoline: exactly one page at the physical load address,
     * 1 MiB. Entered with paging off, so its virtual and physical
     * addresses are equal. It builds the boot page tables, enables
     * paging and continues in the kernel window. Padded to a page so
     * the kernel's physical layout is exact (see below). */
    . = 0x100000;
    .boot : {
        /* Multiboot header: must be 4-byte aligned and within the
         * first 8 KiB of the file. KEEP stops --gc-sections from
         * discarding it, since no code references it. */
        KEEP(*(.multiboot))
        *(.text._start)
        . = ALIGN(4096);
    }

    /* The kernel proper, linked in the kernel window. The physical
     * mapping is exact: physical = virtual - 0x80000000, for code,
     * statics and BSS alike; the boot stub and the frame allocator
     * rely on it, and ld must not insert physical padding of its own.
     * One file-backed section (padded to a page) plus one BSS section
     * keeps VMA-LMA alignment arithmetic trivial. */
    . = 0x80101000;
    _kernel_start = .;

    .kernel : AT(0x101000) {
        *(.text .text.*)
        *(.rodata .rodata.*)
        *(.data .data.*)
        . = ALIGN(4096);
    }

    .bss (NOLOAD) : AT(0x101000 + SIZEOF(.kernel)) {
        *(.bss .bss.*)
        *(COMMON)
        . = ALIGN(4096);
    }

    /* End of the kernel image, 4 KiB aligned so the frame allocator can
     * treat [kernel_start, kernel_end) as whole occupied frames. */
    . = ALIGN(4096);
    _kernel_end = .;

    /* The boot maps the kernel window over physical [0, 8 MiB): the image (its statics, the
     * process pool's records among them) must end inside it. */
    ASSERT(_kernel_end <= 0x80800000, "the kernel image outgrows the 8 MiB kernel window")
}
