/* Linker script for the F2K kernel (Multiboot 1, 32-bit x86) */

OUTPUT_FORMAT("elf32-i386")
OUTPUT_ARCH(i386)

ENTRY(_start)

SECTIONS
{
    /* Load at 1 MiB, above the real-mode/BIOS area (first 640 KiB + ROMs) */
    . = 0x100000;
    _kernel_start = .;

    .text : {
        /* Multiboot header: must be 4-byte aligned and within the first
         * 8 KiB of the file. KEEP stops --gc-sections from discarding it,
         * since no code references it. */
        KEEP(*(.multiboot))
        *(.text._start)
        *(.text .text.*)
    }

    /* Read-only data */
    .rodata : {
        *(.rodata .rodata.*)
    }

    /* Data section - initialized data */
    .data : {
        *(.data .data.*)
    }

    /* BSS section - uninitialized data (includes the boot stack) */
    .bss : {
        *(.bss .bss.*)
        *(COMMON)
    }

    /* End of the kernel image, 4 KiB aligned so the frame allocator can
     * treat [kernel_start, kernel_end) as whole occupied frames. */
    . = ALIGN(4096);
    _kernel_end = .;
}
