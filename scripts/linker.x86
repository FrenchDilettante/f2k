/* Linker script for the F2K kernel, ntoskrnl (32-bit x86). The link is an ELF the export generator
 * turns into the PE32 image ntoskrnl.exe (tools/exportgen/src/pe.rs), which the boot loader
 * (kernel/loader) maps at its base and enters; the build script links it with --emit-relocs, so
 * the image carries its base relocations. */

OUTPUT_FORMAT("elf32-i386")
OUTPUT_ARCH(i386)

/* The image's entry point (AddressOfEntryPoint): kernel/src/boot/mod.rs. */
ENTRY(_start)

/* The kernel's image base: the kernel image window's start plus its first directory entry's span,
 * the entry span (layout::NTOSKRNL_BASE in kernel/src/mem/layout.rs). */
__ImageBase = 0x80400000;

SECTIONS
{
    /* The image as its PE32 form maps it: a page for the headers at the base, then code, constant
     * data, data and BSS, each starting on a page right after the previous one. Mapped through the
     * kernel image window, the image lies at physical = virtual - 0x80000000; the frame allocator
     * relies on it. */
    . = __ImageBase + 0x1000;

    .text : {
        _kernel_start = .;
        *(.text .text.*)
    }

    . = ALIGN(4096);
    .rdata : {
        /* The table of the kernel's exports' bodies (kernel/src/exports.rs): nothing references
         * it, and it is what keeps each body in the link. */
        KEEP(*(.rodata.ntoskrnl_exports))
        /* The table of the HAL-named entry points' bodies (kernel/src/hal/exports.rs, from
         * kernel/hal_exports.toml): same, for the .sys loader's hal.dll import resolution. */
        KEEP(*(.rodata.hal_exports))
        *(.rodata .rodata.*)
    }

    . = ALIGN(4096);
    .data : {
        *(.data .data.*)
    }

    . = ALIGN(4096);
    .bss (NOLOAD) : {
        *(.bss .bss.*)
        *(COMMON)
        /* End of the kernel image, 4 KiB aligned so the frame allocator can treat the image's
         * frames as whole occupied frames. */
        . = ALIGN(4096);
        _kernel_end = .;
    }

    /* The loader maps the kernel image window over physical [0, 16 MiB) (KERNEL_IMAGE in
     * kernel/src/mem/layout.rs): the image (its statics, the process pool's records among them),
     * and the export directory and base relocations the image adds after it, must end inside it. */
    ASSERT(_kernel_end <= 0x81000000, "the kernel image outgrows the 16 MiB kernel image window")
}
