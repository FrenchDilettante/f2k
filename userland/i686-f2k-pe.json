{
  "llvm-target": "i686-pc-windows-msvc",
  "data-layout": "e-m:x-p:32:32-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32-a:0:32-S32",
  "arch": "x86",
  "target-endian": "little",
  "target-pointer-width": 32,
  "target-c-int-width": 32,
  "os": "windows",
  "target-family": [
    "windows"
  ],
  "cpu": "i686",
  "max-atomic-width": 64,
  "merge-functions": "disabled",
  "panic-strategy": "abort",
  "binary-format": "coff",
  "archive-format": "coff",
  "is-like-windows": true,
  "is-like-msvc": true,
  "abi-return-struct-as-int": true,
  "dynamic-linking": true,
  "dll-prefix": "",
  "dll-suffix": ".dll",
  "exe-suffix": ".dll",
  "staticlib-prefix": "",
  "staticlib-suffix": ".lib",
  "linker": "rust-lld",
  "linker-flavor": "msvc-lld",
  "lld-flavor": "link",
  "linker-is-gnu": false,
  "no-default-libraries": true,
  "debuginfo-kind": "pdb",
  "emit-debug-gdb-scripts": false,
  "stack-probes": {
    "kind": "inline"
  },
  "pre-link-args": {
    "msvc-lld": [
      "/NOLOGO",
      "/NODEFAULTLIB",
      "/DYNAMICBASE:NO",
      "/NXCOMPAT:NO",
      "/SUBSYSTEM:WINDOWS,5.0",
      "/OSVERSION:5.0"
    ]
  },
  "env": "msvc",
  "vendor": "pc"
}
